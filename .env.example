# Copy to `.env.local` and fill in values. Never commit `.env.local`.
#
# "Target" = where you run the app:
#   local  → npm run dev + Stripe CLI webhook forward (below)
#   vercel → set the same vars in Project → Settings → Environment Variables

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Phone LAN preview (npm run dev:lan): your PC Wi‑Fi IPv4 from ipconfig
# DEV_LAN_HOST=192.168.12.132

# Auth (use a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-string
# JWT_SECRET=optional-alias-for-AUTH_SECRET

# --- Neon Postgres (required for durable markets / ledger / withdrawals on deploy) ---
# Dashboard: Connection details → use the *pooled* connection string (host often ends in -pooler)
# App reads POSTGRES_URL first, then DATABASE_URL.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# DATABASE_URL=

# --- OpenAI (Peak AI feed markets + user peak → market cards) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# TAVILY_API_KEY=

# --- Stripe (Peakpoints *deposits* via Checkout — not withdrawals) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional subscription prices (pricing page)
# STRIPE_PRICE_PEAKPLUS=
# STRIPE_PRICE_PEAKPRO=
# STRIPE_PRICE_PEAKENTERPRISE=

# --- Dev-only: skip Stripe and POST deposit to /api/peakpoints ---
# ALLOW_STUB_PEAKPOINTS_DEPOSIT=true

# --- Cron + admin (Vercel crons in vercel.json; optional for local manual calls) ---
CRON_SECRET=change-me-cron-secret
ADMIN_EMAILS=you@example.com

# --- Live tab (optional) ---
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# NEXT_PUBLIC_LIVEKIT_URL=

# --- Unusual Whales (Peakflow subscriber desk + /whales personal PWA) ---
# REST + MCP share this key. Never expose it to the browser.
# Set UNUSUAL_WHALES_API_KEY on Vercel for Production, Preview, and Development,
# then redeploy — existing deployments keep the env they were built/started with.
# UNUSUAL_WHALES_API_KEY=
# UW_API_KEY=   # alias for UNUSUAL_WHALES_API_KEY
# UW_DEMO_MODE=true   # force labeled demo data even if a key is set
# Owner-only personal app at /whales (Add to Home Screen).
# This is a dedicated unlock password — NOT UNUSUAL_WHALES_API_KEY.
# Paste UW_PERSONAL_ACCESS_TOKEN into the /whales form (or sign in as ADMIN_EMAILS).
# UW_PERSONAL_ACCESS_TOKEN=long-random-string
# Optional Bearer token for POST /api/unusual-whales/mcp (falls back to CRON_SECRET)
# UW_MCP_TOKEN=
# Official hosted MCP for Cursor / agents (not the Peaksees dashboards):
#   Project config: .cursor/mcp.json
#   URL: https://api.unusualwhales.com/api/mcp
#   Authorization: Bearer <UNUSUAL_WHALES_API_KEY>
# Cursor interpolates ${env:UNUSUAL_WHALES_API_KEY} from the process environment
# (export it in your shell or Cursor env — .env.local is for Next.js, not mcp.json).
# UW_API_KEY is an app-only alias; set UNUSUAL_WHALES_API_KEY for the Cursor MCP.
